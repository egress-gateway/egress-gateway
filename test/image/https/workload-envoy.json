{
  "node": {
    "id": "workload",
    "cluster": "https-component"
  },
  "static_resources": {
    "listeners": [
      {
        "name": "workload",
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8443
          }
        },
        "per_connection_buffer_limit_bytes": 65536,
        "listener_filters": [
          {
            "name": "envoy.filters.listener.local_ratelimit",
            "typed_config": {
              "@type": "type.googleapis.com/envoy.extensions.filters.listener.local_ratelimit.v3.LocalRateLimit",
              "stat_prefix": "inspection",
              "token_bucket": {
                "max_tokens": 64,
                "tokens_per_fill": 64,
                "fill_interval": "1s"
              }
            }
          },
          {
            "name": "envoy.filters.listener.tls_inspector",
            "typed_config": {
              "@type": "type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector"
            }
          }
        ],
        "filter_chains": [
          {
            "transport_socket_connect_timeout": "3s",
            "transport_socket": {
              "name": "envoy.transport_sockets.tls",
              "typed_config": {
                "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext",
                "require_sni": true,
                "disable_stateless_session_resumption": true,
                "disable_stateful_session_resumption": true,
                "common_tls_context": {
                  "custom_tls_certificate_selector": {
                    "name": "envoy.tls.certificate_selectors.on_demand_secret",
                    "typed_config": {
                      "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.cert_selectors.on_demand_secret.v3.Config",
                      "config_source": {
                        "resource_api_version": "V3",
                        "api_config_source": {
                          "api_type": "DELTA_GRPC",
                          "transport_api_version": "V3",
                          "grpc_services": [
                            {
                              "envoy_grpc": {
                                "cluster_name": "inspection_sds"
                              }
                            }
                          ]
                        }
                      },
                      "certificate_mapper": {
                        "name": "envoy.tls.certificate_mappers.sni",
                        "typed_config": {
                          "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.cert_mappers.sni.v3.SNI",
                          "default_value": "invalid/sni"
                        }
                      }
                    }
                  }
                }
              }
            },
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "stat_prefix": "workload",
                  "normalize_path": true,
                  "merge_slashes": true,
                  "path_with_escaped_slashes_action": "REJECT_REQUEST",
                  "use_remote_address": true,
                  "skip_xff_append": true,
                  "forward_client_cert_details": "SANITIZE",
                  "max_request_headers_kb": 16,
                  "request_timeout": "10s",
                  "stream_idle_timeout": "10s",
                  "common_http_protocol_options": {
                    "max_headers_count": 64,
                    "idle_timeout": "30s",
                    "max_connection_duration": "60s"
                  },
                  "http2_protocol_options": {
                    "max_concurrent_streams": 16
                  },
                  "route_config": {
                    "name": "workload",
                    "virtual_hosts": [
                      {
                        "name": "targets",
                        "domains": [
                          "*"
                        ],
                        "routes": [
                          {
                            "match": {
                              "prefix": "/"
                            },
                            "route": {
                              "cluster": "next_hop",
                              "timeout": "5s"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "http_filters": [
                    {
                      "name": "gateway.request",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua",
                        "default_source_code": {
                          "inline_string": "error(\"daemon must install the request adapter\")"
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.ext_authz",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthz",
                        "transport_api_version": "V3",
                        "failure_mode_allow": false,
                        "include_tls_session": true,
                        "with_request_body": {
                          "max_request_bytes": 65536,
                          "allow_partial_message": false,
                          "pack_as_bytes": false
                        },
                        "grpc_service": {
                          "envoy_grpc": {
                            "cluster_name": "opa"
                          },
                          "timeout": "1s"
                        },
                        "validate_mutations": true,
                        "decoder_header_mutation_rules": {
                          "disallow_all": true,
                          "disallow_is_error": true
                        }
                      }
                    },
                    {
                      "name": "gateway.dispatch",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua",
                        "default_source_code": {
                          "inline_string": "error(\"daemon must install the request adapter\")"
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ],
                  "access_log": [
                    {
                      "name": "envoy.access_loggers.stdout",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog",
                        "log_format": {
                          "text_format_source": {
                            "inline_string": "workload request_id=%REQ(X-REQUEST-ID)% method=%REQ(:METHOD)% path=%REQ(:PATH)% authority=%REQ(:AUTHORITY)% scheme=%REQ(:SCHEME)% peer=%DOWNSTREAM_PEER_URI_SAN% status=%RESPONSE_CODE% details=%RESPONSE_CODE_DETAILS%\n"
                          }
                        }
                      }
                    }
                  ],
                  "preserve_external_request_id": true
                }
              }
            ]
          }
        ]
      }
    ],
    "clusters": [
      {
        "name": "opa",
        "connect_timeout": "2s",
        "type": "STRICT_DNS",
        "load_assignment": {
          "cluster_name": "opa",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 9191
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "circuit_breakers": {
          "thresholds": [
            {
              "max_connections": 64,
              "max_pending_requests": 64,
              "max_requests": 64,
              "max_retries": 0
            }
          ]
        },
        "http2_protocol_options": {}
      },
      {
        "name": "next_hop",
        "connect_timeout": "2s",
        "type": "STRICT_DNS",
        "load_assignment": {
          "cluster_name": "next_hop",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "egress",
                        "port_value": 8443
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "circuit_breakers": {
          "thresholds": [
            {
              "max_connections": 64,
              "max_pending_requests": 64,
              "max_requests": 64,
              "max_retries": 0
            }
          ]
        },
        "transport_socket": {
          "name": "envoy.transport_sockets.tls",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext",
            "sni": "egress",
            "common_tls_context": {
              "tls_certificates": [
                {
                  "certificate_chain": {
                    "filename": "/certs/workload.pem"
                  },
                  "private_key": {
                    "filename": "/certs/workload-key.pem"
                  }
                }
              ],
              "validation_context": {
                "trusted_ca": {
                  "filename": "/certs/mesh-ca.pem"
                },
                "match_typed_subject_alt_names": [
                  {
                    "san_type": "URI",
                    "matcher": {
                      "exact": "spiffe://fixture.test/ns/gateway/sa/egress"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      {
        "name": "inspection_sds",
        "connect_timeout": "2s",
        "type": "STRICT_DNS",
        "load_assignment": {
          "cluster_name": "inspection_sds",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 9191
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "circuit_breakers": {
          "thresholds": [
            {
              "max_connections": 64,
              "max_pending_requests": 64,
              "max_requests": 128,
              "max_retries": 0
            }
          ]
        },
        "http2_protocol_options": {}
      }
    ]
  },
  "overload_manager": {
    "resource_monitors": [
      {
        "name": "envoy.resource_monitors.global_downstream_max_connections",
        "typed_config": {
          "@type": "type.googleapis.com/envoy.extensions.resource_monitors.downstream_connections.v3.DownstreamConnectionsConfig",
          "max_active_downstream_connections": 64
        }
      },
      {
        "name": "envoy.resource_monitors.fixed_heap",
        "typed_config": {
          "@type": "type.googleapis.com/envoy.extensions.resource_monitors.fixed_heap.v3.FixedHeapConfig",
          "max_heap_size_bytes": 67108864
        }
      }
    ],
    "actions": [
      {
        "name": "envoy.overload_actions.stop_accepting_connections",
        "triggers": [
          {
            "name": "envoy.resource_monitors.fixed_heap",
            "threshold": {
              "value": 0.75
            }
          }
        ]
      }
    ]
  }
}
